time="2025-12-02T00:05:14+08:00" level=info msg="message[hello_world]chat[failed] error_msg[doRequest: error sending request: Post \"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent\": dial tcp 142.250.73.106:443: i/o timeout]" func="github.com/glstr/futty_golang/logger.(*LogrusLogger).Notice" file="/Users/sweetie/pengbaojiang/code/gosrc/gopath/src/github.com/glstr/futty_golang/logger/logruslogger.go:32"
